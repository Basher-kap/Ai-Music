{
  "expo": {
    "name": "Ai-Music",
    "slug": "Ai-Music",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ai_icon.png",
    "scheme": "aimusic",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nagiiiqt.AiMusic",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["aimusic"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon.png",
        "backgroundImage": "./assets/images/android-icon.png",
        "monochromeImage": "./assets/images/android-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "package": "com.nagiiiqt.AiMusic"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-96x96.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "ios": {
            "backgroundColor": "#ffffff",
            "image": "./assets/images/ai_icon.jpg",
            "resizeMode": "cover"
          },
          "android": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/ai_icon.jpg",
            "imageWidth": 200
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/marcellus/400Regular/Marcellus_400Regular.ttf",
            "./node_modules/@expo-google-fonts/playwrite-gb-s/400Regular/PlaywriteGBS_400Regular.ttf",
            "./node_modules/@expo-google-fonts/dancing-script/600SemiBold/DancingScript_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/fredoka/600SemiBold/Fredoka_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/almendra-display/400Regular/AlmendraDisplay_400Regular.ttf",
            "./node_modules/@expo-google-fonts/medievalsharp/400Regular/MedievalSharp_400Regular.ttf",
            "./node_modules/@expo-google-fonts/syne/600SemiBold/Syne_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/russo-one/400Regular/RussoOne_400Regular.ttf",
            "./node_modules/@expo-google-fonts/metal-mania/400Regular/MetalMania_400Regular.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "353cfb2f-2f22-42d7-92c0-a5e5adfa4d2f"
      }
    },
    "owner": "nagiiiqt",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/353cfb2f-2f22-42d7-92c0-a5e5adfa4d2f"
    }
  }
}
